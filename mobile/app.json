{
  "expo": {
    "name": "CareLoop",
    "slug": "careloop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parth.careloop"
    },
    "android": {
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.parth.careloop",
      "permissions": [
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "CareLoop listens only after you tap Speak, to turn your words into a note.",
          "speechRecognitionPermission": "CareLoop turns your spoken words into text so you can check them before saving."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow CareLoop to select an emergency or doctor contact you choose."
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "CareLoop uses the camera only when you photograph a prescription for it to read.",
          "photosPermission": "CareLoop opens a prescription photo you choose so it can read it.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#176A46"
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
